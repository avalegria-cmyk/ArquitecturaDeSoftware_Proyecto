APP_PORT=8088
# Base del monolito (solo para la migración de datos)
MYSQL_DATABASE=uniequipos
MYSQL_USER=uniequipos
MYSQL_PASSWORD=cambiar-clave-local
MYSQL_ROOT_PASSWORD=cambiar-root-local
JWT_SECRET=reemplazar-por-una-clave-aleatoria-de-64-caracteres
# Clave compartida entre el gateway y los microservicios (cabeceras internas)
INTERNAL_TOKEN=reemplazar-token-interno
# Microservicios: MySQL compartido con una base y un usuario por servicio
MICRO_MYSQL_ROOT_PASSWORD=cambiar-micro-root
IDENTIDAD_DB_PASSWORD=cambiar-identidad
REPORTES_DB_PASSWORD=cambiar-reportes
# MongoDB del catálogo
MONGO_ROOT_PASSWORD=cambiar-mongo-root
CATALOGO_DB_PASSWORD=cambiar-catalogo
CATALOGO_APP_KEY=cambiar-app-key-catalogo
# PostgreSQL de reservas y préstamos
POSTGRES_ROOT_PASSWORD=cambiar-postgres-root
RESERVAS_DB_PASSWORD=cambiar-reservas
PRESTAMOS_DB_PASSWORD=cambiar-prestamos
# RabbitMQ (mensajería asíncrona)
RABBITMQ_PASSWORD=cambiar-rabbitmq
COOKIE_SECURE=0
APP_ORIGIN=http://localhost:8088

# phpMyAdmin (MySQL de los microservicios)
PMA_PORT=8089
# API Gateway (para probar con Postman)
GATEWAY_PORT=3000
# Panel de RabbitMQ
RABBITMQ_UI_PORT=15672
